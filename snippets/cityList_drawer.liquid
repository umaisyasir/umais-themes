function initializeCityDropdown() {
    var citiesList = citiesListUnsort;
    var noSelectedOption = `<option id="noSelectedOption" value="0">Select City Name</option>`;
    var cityNames = '';
    var i;
    for (i = 0; i < citiesList.length; i++) {
        cityNames += `<option value="${citiesList[i]}"> ${citiesList[i]}</option>`;
    }

    document.getElementById('cityNameDropdown').innerHTML = noSelectedOption + cityNames;

    document.addEventListener('DOMContentLoaded', () => {
