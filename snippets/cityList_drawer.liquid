    var citiesList = citiesListUnsort.sort();
    var noSelectedOption = `<option id="noSelectedOption" value="0">Select City Name</option>`;
    var cityNames = '';
    var i;
    for (i = 0; i < citiesList.length; i++) {
      cityNames += `<option value="${citiesList[i]}"> ${citiesList[i]}</option>`;
    }
    
    document.getElementById('cityNameDropdown').innerHTML = noSelectedOption + cityNames;
    
    function cityDropdownValidation() {
      var checkSelectedDropdown = document.getElementById('cityNameDropdown').selectedIndex;
      var cityNoSelectedValue = document.getElementsByTagName('option')[checkSelectedDropdown].value;
      
      console.log(cityNoSelectedValue);
  
  
  
      var numInput = document.getElementById('cstm-ph-number');
      var numInputLength = numInput.value.length;
  
      var numError = document.querySelector('.number-error');
  
      if (numInputLength < 11) {
            // e.preventDefault();
            console.log("Number Should be 11 Digits") 
            numError.classList.add('isActive')
            // $('<p class="number-error" style="color:red;font-weight:700;">Phone Number must be 11 Digit Number</p>').insertAfter($('#cstm-phone-number').parent());
            // setTimeout(function(){ 
            //   $('#continue_button').removeClass("btn--loading");
            //   $('#continue_button').prop( "disabled", false );
            //   $('.number-error').remove();
            // }, 3000);
            return  false;
      }
      else{
        numError.classList.remove('isActive')
      }
      
      if (cityNoSelectedValue == 0) {
        console.log("not")
        document.getElementById('cityDropdwonErrorText').style.display = 'block';
        console.log(cityNoSelectedValue.value)
      } else {
        console.log("yes")
        window.location = `/checkout?checkout[shipping_address][city]=${cityNoSelectedValue}`;
        document.getElementById('cityDropdwonErrorText').style.display = 'none';
        
      }
    }
    
    document.addEventListener('ready',()=>{
     document.querySelector('.cart-block__buttons .cart__checkout-button').addEventListener('click',(e)=>{
        e.preventDefault();
        cityDropdownValidation()
      });
    });
    
    $(document).ready(function() {
        $('#cityNameDropdown').select2();
    })
    
    
  </script>
  
