.swiper-container-vertical > .swiper-pagination-bullets .swiper-pagination-bullet {
  margin: 10px 0;
  height: 10px;
  width: 10px;
}

.swiper-pagination-bullet-active {
  background: #FFF;
}

  .mobile_image{
    display: none;
  }

  @media only screen and (max-width: 767px){
  .mobile_image{
    display: block;
  }  

  .desktop_image{
    display: none;
  }
  }
.vertical_slider_holder {
    height: 100vh !important;
    width: 100%;
}
.vertical_slider_holder .swiper-slide {
    min-height: 100vh;
    width: 100%;
    height: 100vh;
}
.image__banner-image, .video__banner-video {
    height: 100%;
}
.image__banner-image, .video__banner-video {
    height: 100%;
}
.image__banner-image img, .video__banner-video video {
    width: 100%;
    object-position: center center;
    height: 100%;
    object-fit: cover;
}
</style>
<section class="vertical_slider_holder">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div class="swiper-slide">
        <div class="image__banner-image">
        <a href="{{ block.settings.link }}">
        <img class="desktop_image" src="{{ block.settings.desktop_image | img_url:'master' }}" width="100%" height="auto">
        <img class="mobile_image" src="{{ block.settings.mobile_image | img_url:'master' }}" width="100%" height="auto">
        </a>
        </div>
        </div>
        {% endfor %}
        <!-- <div class="swiper-slide">
        <div class="image__banner-image">
          { % section 'footer' %}
        </div>
        </div> -->
    </div>
    <div class="swiper-pagination"></div>
</section>
<script>

document.addEventListener("DOMContentLoaded", (event) => {
const sliderSettings={
    direction: "vertical",
    speed: 900,
    mousewheel: true,
    updateOnWindowResize:true,
    slidesPerView: 1,
    
      autoplay: {
      delay: Number(7000),
    },
    
    
    keyboard: {
      enabled: true,
      onlyInViewport: false,
    },
    
    effect: "slide",
      
    }

let featured__media_wrapper = new Swiper('.vertical_slider_holder',sliderSettings);
  });
</script>


{% schema %}
  {
    "name": "Vertical Slider",
    "settings": [
                    
				],
	"blocks": [
				{
				"name": "slider",
				"type": "Slide",
				"settings": [
								{
								"type": "image_picker",
								"id": "desktop_image",
								"label": "Choose Pictures For Slider"
								},
                               
                                 {
								"type": "image_picker",
								"id": "mobile_image",
								"label": "Choose Pictures For Slider"
								},
                               {
        				 		"type": "url",
        				 		"id": "link",
        						"label": "Select Link Link"
				            	}
							]	
				
						}
					],


"presets": [
      {
        "name": "Vertical Slider"
      }
     ]
  				
}

{% endschema %}
